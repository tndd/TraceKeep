{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PC Diagnostics",
  "version": "0.1.0",
  "identifier": "dev.tndd.pcdiagnostics",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PC Diagnostics",
        "width": 1320,
        "height": 900,
        "minWidth": 720,
        "minHeight": 600,
        "backgroundColor": "#080e19"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": { "active": false }
}
